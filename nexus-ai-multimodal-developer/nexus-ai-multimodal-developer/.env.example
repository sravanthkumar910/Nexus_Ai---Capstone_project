# --- Database ---
DATABASE_URL=sqlite:///./data/nexus.db
# For PostgreSQL instead: postgresql://user:password@localhost:5432/nexus
# For MongoDB metadata storage, see README "Swapping to MongoDB".
MONGODB_URI=

# --- Models ---
MODEL_CACHE_DIR=./models/checkpoints
HUGGINGFACE_TOKEN=
# Reliable offline defaults. Set VISION_MODEL=vit_b_16 and TEXT_MODEL=bert-base-uncased
# only when pretrained weights are available locally or network access is enabled.
VISION_MODEL=lightweight_cnn
TEXT_MODEL=lightweight_bilstm
AUDIO_MODEL=librosa_mfcc
WHISPER_MODEL=openai/whisper-tiny
VIDEO_MODEL=temporal_transformer

# --- Architecture ---
COMMON_EMBEDDING_DIM=512
NUM_FRAMES=8
FREEZE_ENCODERS=true

# --- Training (see training/config.py) ---
LEARNING_RATE=0.0001
BATCH_SIZE=16
EPOCHS=20
DROPOUT=0.1
WEIGHT_DECAY=0.0001

# --- Runtime ---
DEVICE=auto
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
SECRET_KEY=change-me-in-production
MAX_UPLOAD_MB=200

# --- Storage ---
REPORTS_DIR=./reports
UPLOADS_DIR=./data/raw
